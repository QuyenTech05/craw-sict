# VM-EMBED 4 GiB: copy thành .env, điền EMBED_BIND bằng IP private. KHÔNG commit .env thật.
# Các biến store bên dưới chỉ dành cho batch host bên ngoài serving, không cần cho dịch vụ embed.

# --- Chỉ dùng khi chạy batch ngoài serving: trỏ về VM-SERVE qua mạng private ---
# D12: mật khẩu / khoá = đúng giá trị POSTGRES_PASSWORD / REDIS_PASSWORD / QDRANT_API_KEY trong .env VM1
# (tạo bằng `scripts/store_auth.sh init-env` trên VM-SERVE). Không chạy cron trên VM-EMBED.
POSTGRES_DSN=postgresql+asyncpg://sict:<POSTGRES_PASSWORD>@<IP-VM1>:5432/sict_crawler
REDIS_URL=redis://:<REDIS_PASSWORD>@<IP-VM1>:6379/0
QDRANT_HOST=<IP-VM1>
QDRANT_API_KEY=<QDRANT_API_KEY>
QDRANT_TIMEOUT=120

# --- Index v3 (BẮT BUỘC cho production) ---
# Thiếu hoặc sai cấu hình v3, worker từ chối khởi động để tránh ghi sai index.
# Kiểm trước khi bấm CD: `scripts/cutover_v3.sh env-check vm2` (chỉ in tên biến). Giá trị phải GIỐNG .env VM1.
EMBED_BACKEND=api
# Embed dùng Docker network external sict-vm2. Batch host có network riêng nếu chạy tách máy.
# VM-SERVE cấu hình EMBED_API_BASE=http://<IP-private-VM-EMBED>:8090/v1.
EMBED_API_BASE=http://embed:8090/v1
# Bắt buộc cùng một secret với VM-SERVE, embed_server và Alloy.
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
# cache vector sqlite (tuỳ chọn, nằm trong volume localstore): bỏ trống = không cache
# EMBED_CACHE_PATH=/app/_local_store/embed_cache.sqlite
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
# D23: chunk theo khối DOM (index v3 bật)
CHUNK_STRUCTURED=1

# --- Dùng cho batch ngoài serving khi chạy theo lệnh riêng (không tự chạy trên VM-EMBED) ---
CHECK_EDITS=50
CRAWL_LIMIT=200
ANNOTATE_OCR_N=2000
# CYCLE_BUDGET_SEC=300
# CRON_INTERVAL_SEC=43200
# CRON_RETRY_SEC=300  # chờ ngắn sau lượt incremental thất bại
# CRON_MEM_LIMIT=1024m   # chỉ cấp trên batch host độc lập

# --- S3 AWS (giống VM1, region us-east-2 = cùng region VM để khỏi tốn egress) ---
# AWS_PROFILE=quyen-admin
# Hoặc key rời nếu VM2 không có ~/.aws:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=  # để trống = AWS thật

CRAWLER_BACKEND=auto
HF_TOKEN=

# --- Image (CD ghi tự động, D10 — không sửa tay; rollback = chạy CD với tag cũ) ---
# WORKER_IMAGE=ghcr.io/quyentech05/sict-worker:<sha>
# EMBED_IMAGE=ghcr.io/quyentech05/sict-embed:<sha>
# Dịch vụ embed (docker-compose.embed.yml): nghe trên IP private VM2 để API ở VM1 gọi được (SG chỉ mở 8090 cho VM1)
EMBED_BIND=<IP-private-VM2>
EMBED_MEM_LIMIT=3500m
EMBED_THREADS=2
EMBED_CONCURRENCY=1
EMBED_IMAGE_BATCH=1
EMBED_TEXT_MAX_LEN=1536
EMBED_TOKEN_BUDGET=1536
EMBED_QUERY_IMAGE_SIZES=336
# Artifact cần dựng trước trên host >= 6 GiB RAM, sau đó lưu đúng volume embedhf.

# Space cho văn bản và ảnh; cần eval so với index trước khi bật.
# EMBEDDING_BASE_URL=https://quyendzvaio-sict.hf.space
# EMBEDDING_ENDPOINT=/gradio_api/call/embed
# EMBEDDING_MODEL=jinaai/jina-clip-v2
# EMBEDDING_DIMENSION=1024
# HF_TOKEN=  # đặt trong .env thật, không commit
