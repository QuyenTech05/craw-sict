# VM nhỏ (1 GB) cho BỘ TRỢ LÝ — máy chạy stores + API + nginx (VM1).
# Copy thành .env trên máy đó. KHÔNG commit file .env thật.
#
# Tổng RAM thực dùng đo trên dev box (2026-11-13): postgres 189 + qdrant 246 + redis 16 + api 172 + nginx 10
# ≈ 660 MiB; mem_limit bên dưới cắt xuống ~950 MiB để vừa 1 GB + swap 2 GB (scripts/vm_swap.sh).
# Embed KHÔNG chạy trên máy này — dùng Jina Cloud (EMBED_API_BASE=...: xem khối v3 phía dưới).

# --- LLM trả lời (giữ như bản production) ---
LLM_API_BASE=https://kiraai.vn/api/v1
LLM_MODEL=gpt-oss-120b-sale
LLM_API_KEY=

# --- Store auth (tạo bằng `scripts/store_auth.sh init-env`, KHÔNG tự đặt tay) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# --- giới hạn RAM chặt cho máy 1 GB ---
PG_MEM_LIMIT=380m
QDRANT_MEM_LIMIT=420m
API_MEM_LIMIT=450m
# nginx: 150m (cố định trong compose); redis 300m (cấu hình này đủ vì maxmemory 64 MB)

# --- Index v3 (giá trị phải GIỐNG hai máy; kiểm: scripts/cutover_v3.sh env-check vm1) ---
EMBED_BACKEND=api
EMBED_API_BASE=https://api.jina.ai/v1
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
EMBED_QUERY_IMAGE_SIZE=336
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
CHUNK_STRUCTURED=1

# --- Port nội bộ mở cho worker (VM2) ---
# Máy này là máy duy nhất mở store ra ngoài. Chỉ cho IP của máy worker vào 5432/6379/6333/6334 (xem docs/deploy_small_vm.md).
STORE_BIND=0.0.0.0

# --- Image (CD ghi tự động; để trống lần đầu = compose build/ chạy image local) ---
# API_IMAGE=ghcr.io/quyendzvaio/sict-api:<sha>

# Tuỳ chọn Space cho văn bản; cần eval so với index trước khi bật.
# EMBED_TEXT_PROVIDER=hf-space
# EMBED_IMAGE_PROVIDER=hf-space
# HF_SPACE_URL=https://quyendzvaio-sict.hf.space
# HF_TOKEN=
