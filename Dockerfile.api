# syntax=docker/dockerfile:1
# API serve: HTTP embedding client; không tải model local.
# Deps quản lý bằng uv (group api + uv.lock).
# Build: docker build -f Dockerfile.api -t sict-api .
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1
RUN useradd -m -u 10000 app
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --group api
COPY config.yaml ./
COPY sict_crawler ./sict_crawler
ENV PATH="/app/.venv/bin:$PATH"
USER 10000
EXPOSE 8000
CMD ["uvicorn", "sict_crawler.api.routes:app", "--host", "0.0.0.0", "--port", "8000"]
