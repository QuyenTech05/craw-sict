# VM1 AWS 2 GB: stores + API + nginx. Copy thành .env; không commit .env thật.
# Bắt buộc swap 2 GB; embed chạy trên VM2. Xem docs/deploy_small_vm.md.

# --- LLM trả lời (giữ như bản production) ---
LLM_API_BASE=https://kiraai.vn/api/v1
LLM_MODEL=gpt-oss-120b-sale
LLM_API_KEY=

# --- Store auth (tạo bằng `scripts/store_auth.sh init-env`, KHÔNG tự đặt tay) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# --- Giới hạn RAM; tổng cap 2250m lớn hơn RAM vật lý, cần swap và theo dõi OOM ---
PG_MEM_LIMIT=500m
QDRANT_MEM_LIMIT=800m
REDIS_MEM_LIMIT=200m
REDIS_MAXMEMORY=64mb
API_MEM_LIMIT=600m
NGINX_MEM_LIMIT=150m

# --- Index v3 (giá trị phải GIỐNG hai máy; kiểm: scripts/cutover_v3.sh env-check vm1) ---
EMBED_BACKEND=api
EMBED_API_BASE=http://<IP-private-VM2>:8090/v1
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
EMBED_QUERY_IMAGE_SIZE=336
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
CHUNK_STRUCTURED=1

# --- Port nội bộ mở cho worker (VM2) ---
# Máy này là máy duy nhất mở store ra ngoài. Chỉ cho IP của máy worker vào 5432/6379/6333/6334 (xem docs/deploy_small_vm.md).
STORE_BIND=0.0.0.0

# Đọc media đã đồng bộ từ VM2 (thư mục host phải tồn tại, API chỉ đọc).
API_LOCAL_STORE=./_local_store
AWS_PROFILE=

# --- Image (CD ghi tự động; để trống lần đầu = compose build/ chạy image local) ---
# API_IMAGE=ghcr.io/quyendzvaio/sict-api:<sha>

# Tuỳ chọn Space cho văn bản; cần eval so với index trước khi bật.
# EMBEDDING_BASE_URL=https://quyendzvaio-sict.hf.space
# EMBEDDING_ENDPOINT=/gradio_api/call/embed
# EMBEDDING_MODEL=jinaai/jina-clip-v2
# EMBEDDING_DIMENSION=1024
# HF_TOKEN=
