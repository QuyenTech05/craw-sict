# VM worker 512 MB (Eco Micro) — chạy cron incremental (docker-compose.worker-lite.yml).
# Copy thành .env trên máy worker. KHÔNG commit file .env thật.
#
# Vì sao cấu hình này chạy được trong 512 MB (số đo trial-24h: 30.052 mẫu / 12 ngày):
#   - worker < 200 MiB ở 99,7% mẫu; đỉnh 400–969 MiB rơi đúng cửa sổ rebuild graph khái niệm
#     → graph tách sang `--graph-only` chạy NGAY SAU lượt crawl, cùng mem_limit 512m;
#   - không Obscura (Chrome headless +150 MB) → CRAWLER_BACKEND=httpx;
#   - không embed tại chỗ → Jina Cloud (máy worker không nhốt nổi tháp ONNX 1,4 GB).

# --- Trỏ về VM1 (bắt buộc): IP/hostname máy 1 GB, KHÔNG phải localhost ---
POSTGRES_DSN=postgresql+asyncpg://sict:<POSTGRES_PASSWORD>@<IP-VM1>:5432/sict_crawler
REDIS_URL=redis://:<REDIS_PASSWORD>@<IP-VM1>:6379/0
QDRANT_HOST=<IP-VM1>
QDRANT_API_KEY=
QDRANT_TIMEOUT=120
# Mật khẩu / API key = đúng giá trị trong .env của VM1 (scripts/store_auth.sh init-env).

# --- Index v3 (giống VM1) ---
EMBED_BACKEND=api
EMBED_API_BASE=https://api.jina.ai/v1
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
EMBED_QUERY_IMAGE_SIZE=336
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
CHUNK_STRUCTURED=1

# --- Crawl: httpx (không Obscura) + ngân sách rộng hơn cho máy 1 vCPU chậm ---
CRAWLER_BACKEND=httpx
CHECK_EDITS=50
CRAWL_LIMIT=200
ANNOTATE_OCR_N=0          # collection v3 OCR ngay lúc index → pass riêng chỉ dùng cho v1
CYCLE_BUDGET_SEC=900      # 5 phút → 15 phút: 1 vCPU + mạng ra VM1 chậm hơn dev box
CRON_INTERVAL_SEC=43200
CRON_MEM_LIMIT=512m

# --- Ảnh/file mới: phải dùng chung store với VM1, nếu không ảnh mới sẽ 404 ---
# R2 / B2 / MinIO: đặt S3_ENDPOINT_URL + key. Bỏ trống = _local_store cục bộ trên máy worker
# (ảnh mới ghi vào ổ của worker, API ở VM1 không đọc được → hỏng ảnh của bài mới).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Image (CD ghi tự động) ---
# WORKER_IMAGE=ghcr.io/quyendzvaio/sict-worker:<sha>
