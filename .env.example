# Keys + provider LLM/VLM — COPY nội dung vào /home/ubuntu/craw-sict/.env trên VM1 rồi restart api:
#   ssh -i <khoá>.pem ubuntu@<IP-VM1>
#   nano ~/craw-sict/.env   # dán keys, lưu
#   cd ~/craw-sict && docker compose up -d api
# KHÔNG commit file .env thật.
#
# Yêu cầu provider: OpenAI-compatible — endpoint POST {BASE}/chat/completions,
# auth header "Authorization: Bearer {KEY}", body {model, messages, max_tokens,
# temperature[, stream]}. Hợp lệ: vLLM, llama.cpp server, Ollama (/v1),
# OpenAI, hoặc proxy tương thích. Không cần vision cho LLM chat (text-only);
# VLM caption ảnh mới cần model vision.

# --- LLM chat (trả lời /chat, rewrite query). BẮT BUỘC để có đáp án sinh ---
LLM_API_KEY=
# Base URL + model, mặc định trỏ gateway local (localhost:20128, model sict).
# Đổi khi dùng provider khác, VD OpenAI:
#LLM_API_BASE=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_MODEL=qwen/qwen3.8-27b

# --- VLM caption ảnh (cho pipeline annotate ảnh, mặc định TẮT → dùng OCR local) ---
VLM_API_KEY=
#VLM_API_BASE=https://api.openai.com/v1
#VLM_MODELS=gpt-4o-mini
#VLM_ENABLED=true
VLM_API_BASE=
VLM_MODELS=
VLM_ENABLED=false

# --- HuggingFace (tùy chọn, tăng rate-limit tải E5/CLIP) ---
HF_TOKEN=


# --- Embedding (D22: model đa phương thức jina-clip-v2, chữ+ảnh chung không gian) ---
# EMBED_BACKEND=api duy nhất, endpoint HTTP jina-clip-v2
# (POST {BASE}/embeddings, input: [{"text":..}|{"image": base64}]).
# PRODUCTION index v3 (VM1, 2026-11-05) — bộ biến BẮT BUỘC, cùng giá trị với .env VM2 (.env.worker.example);
# kiểm bằng `scripts/cutover_v3.sh env-check vm1` (chỉ in tên biến); loader so manifest với các biến này, thiếu → không nạp:
#   EMBED_BACKEND=api  EMBED_API_BASE=http://<IP-private-VM2>:8090/v1  EMBED_API_KEY=<secret>  EMBED_MODEL=jina-clip-v2  EMBED_DIM=1024
#   EMBED_QUERY_IMAGE_SIZE=336  QDRANT_COLLECTION_TEXT=sict_text_v3  QDRANT_COLLECTION_IMAGE=sict_image_v3
#   QDRANT_COLLECTION_OCR=sict_ocr_v3  QDRANT_TEXT_DIM=1024  QDRANT_IMAGE_DIM=1024  CHUNK_STRUCTURED=1  API_MEM_LIMIT=320m
EMBED_BACKEND=api
EMBED_API_BASE=http://embed:8090/v1
# Tự host ONNX int8: EMBED_API_KEY bắt buộc, trùng key ở VM-EMBED (không commit secret).
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
# chỉ khi EMBED_API_BASE trỏ dịch vụ tự host: ảnh người dùng gửi chạy tháp ảnh 336 (dịch vụ phải có tháp này:
# EMBED_QUERY_IMAGE_SIZES của embed, mặc định 336; ảnh index giữ 512). Trên 2 vCPU: 336 ~3,8 s / ảnh, 392 ~5,3 s, 512 ~9,6 s
EMBED_QUERY_IMAGE_SIZE=336
# cache vector sqlite theo hash đầu vào (tuỳ chọn; API chỉ nhúng câu hỏi nên thường bỏ trống)
# EMBED_CACHE_PATH=

# --- Chỉ phục vụ ba collection v3 chung không gian 1024-d ---
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
# D23: chunk theo khối DOM (index v3 bật; incremental cùng luật với artifact v3)
CHUNK_STRUCTURED=1

# --- Giới hạn khởi đầu VM-SERVE 2 GiB (tổng 1746 MiB, phải nghiệm thu OOM/RSS thực) ---
API_MEM_LIMIT=320m
PG_MEM_LIMIT=384m
PG_SHARED_BUFFERS=64MB
PG_MAX_CONNECTIONS=20
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=64mb
QDRANT_MEM_LIMIT=850m
NGINX_MEM_LIMIT=64m

# --- Vercel MVP demo-only: token riêng cho job/checkpoint API ---
# Tạo token ngẫu nhiên, đặt cùng giá trị trên VM-SERVE và Vercel (chỉ server env).
# Để trống => FastAPI từ chối /internal/jobs/* (503).
MVP_JOB_TOKEN=
# Function chỉ xử lý OCR public khi cần, nên đặt MVP_OCR_TOKEN nếu expose /api/ocr.
# MVP_OCR_TOKEN=
# Chỉ bật khi muốn API gọi OCR Vercel sau khi đã retrieval ảnh. Mặc định off.
# MVP_OCR_POLICY=off          # off | weak (thiếu evidence/đọc chữ) | always
# MVP_OCR_URL=https://<vercel-project>.vercel.app/api/ocr
# SICT_API_BASE=https://<public-domain-of-VM-SERVE>
# EMBED_API_BASE=https://<public-domain-of-VM-EMBED>/v1

# --- D12: khoá store (VM1). Tạo ngẫu nhiên: scripts/store_auth.sh init-env; CD kiểm: store_auth.sh check vm1 ---
# Bỏ trống trên máy dev = store không khoá và cổng chỉ nghe 127.0.0.1 (như cũ). Chỉ A-Z a-z 0-9 _ -, ≥ 24 ký tự.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# QDRANT_API_KEY=
# VM1: 0.0.0.0 để VM2 tới được — trên EC2 card mạng chỉ có IP private; Security Group chỉ cho SG của VM2 vào
# 5432 / 6379 / 6333-6334. Không đặt riêng IP private: Alloy trên VM1 đọc số liệu store qua localhost.
# STORE_BIND=127.0.0.1

# Space cho văn bản và ảnh; cần eval so với index trước khi bật.
# EMBEDDING_BASE_URL=https://quyendzvaio-sict.hf.space
# EMBEDDING_ENDPOINT=/gradio_api/call/embed
# EMBEDDING_MODEL=jinaai/jina-clip-v2
# EMBEDDING_DIMENSION=1024
# HF_TOKEN=  # đặt trong .env thật, không commit
